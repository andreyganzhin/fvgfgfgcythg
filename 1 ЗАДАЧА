using namespace std;

int main() {
    int k = 109;
    int v, t;
    cin >> v >> t;   
    int ostanovka = v * t;
    int x = ostanovka % k;
    int b = (x + k) % k;
    cout <<"ОТМЕТКА: " << b;
    return 0;
